# =============================================================================
#  BITSOL AI Assistant — Environment Configuration
#  Designed & Developed by BITSOL MARKETING (https://bitsolmarketing.com)
# =============================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME="BITSOL AI Assistant"
APP_URL=http://localhost:3000
# Public base URL the browser uses (exposed to the client).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://bitsol:bitsol_password@localhost:5432/bitsol_assistant?schema=public

# --- Cache (Redis) ----------------------------------------------------------
# Optional. Without it, rate limiting fails open (allows every request).
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
# Rounds for bcrypt password hashing.
BCRYPT_ROUNDS=12

# --- AI Provider ------------------------------------------------------------
# Which provider powers the assistant.
#   claude  -> Anthropic Claude API            (default, recommended)
#   openai  -> OpenAI-compatible API           (OpenAI, Azure OpenAI, Together, etc.)
#   ollama  -> Local Ollama (OpenAI-compatible endpoint)
#   gemini  -> Google Gemini API
AI_PROVIDER=claude
# Model id passed to the selected provider. Leave empty for the provider's
# default: claude-opus-4-8, gemini-3.1-flash-lite, gpt-4o-mini, llama3.1.
AI_MODEL=
# Optional: model for the short JSON call that reads each conversation for the
# customer's details. Defaults to AI_MODEL; a smaller model from the same
# provider (e.g. claude-haiku-4-5) is cheaper and plenty.
AI_EXTRACTION_MODEL=
# Response length cap. Raise it if answers are being cut off.
AI_MAX_TOKENS=1400
# Optional Claude adaptive thinking (deeper, slower). Keep false for a snappy
# public chat widget.
AI_THINKING=false

# Anthropic (claude)
ANTHROPIC_API_KEY=
# Claude Platform on AWS only: use a key generated in the AWS console (under
# Claude Platform on AWS -> API keys) as ANTHROPIC_API_KEY, and set both of these.
# Leave them empty for Anthropic's own API.
#   ANTHROPIC_BASE_URL=https://aws-external-anthropic.us-west-2.api.aws
#   ANTHROPIC_WORKSPACE_ID=wrkspc_...
ANTHROPIC_BASE_URL=
ANTHROPIC_WORKSPACE_ID=

# OpenAI-compatible (openai / ollama)
OPENAI_API_KEY=
# Override for Azure/Together/OpenRouter/Ollama, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (gemini) — a key from https://aistudio.google.com/api-keys.
# The free tier serves the Flash-Lite models with a daily request cap and uses
# the conversations to improve Google's products; the paid tier does neither.
GEMINI_API_KEY=
# Optional: how much a Gemini model thinks before answering — off (Gemini 2.5
# Flash / Flash-Lite), or minimal / low / medium / high (Gemini 3). Thought
# tokens count against AI_MAX_TOKENS. Empty keeps the model's default.
GEMINI_THINKING=

# --- Notifications ----------------------------------------------------------
# Every lead, meeting and ticket queues a notification row.
# A worker reads the `notifications` table and delivers via these channels.

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BITSOL <no-reply@bitsolmarketing.com>"

# SMS gateway
SMS_API_KEY=
SMS_SENDER_ID=BITSOL

# --- WhatsApp Business Cloud API (Meta) -------------------------------------
# Powers the WhatsApp chatbot, template messages and broadcasts.
# Meta ▸ Business App ▸ WhatsApp ▸ API Setup gives you the first two.
#   1. Phone number ID of your business number (a numeric id, NOT the number).
WHATSAPP_PHONE_ID=
#   2. Permanent access token from a System User with the
#      `whatsapp_business_messaging` permission. Temporary tokens expire in 24h.
WHATSAPP_TOKEN=
#   3. Any random string you invent. Type the SAME value into Meta's webhook
#      form as the "Verify token"; Meta echoes it back when it calls the GET
#      verification endpoint. e.g. openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
#   4. App secret (Meta ▸ App settings ▸ Basic ▸ App secret). Every inbound
#      webhook is signed with it — without this the webhook rejects all traffic
#      in production, because an unsigned webhook is an open door.
WHATSAPP_APP_SECRET=
#   5. WhatsApp Business Account ID (Meta ▸ WhatsApp ▸ API Setup, shown just
#      above the phone number ID). Templates belong to the account rather than
#      the number, so this is what the template list, sync and create calls use.
#      Creating templates from the admin panel additionally needs the token to
#      carry `whatsapp_business_management`, not just `whatsapp_business_messaging`.
#      Leave blank to keep sending messages with hand-maintained templates.
WHATSAPP_WABA_ID=
# Graph API version used for outbound calls.
WHATSAPP_API_VERSION=v21.0
# Set false to keep the number connected but stop the assistant from replying
# (useful while your team handles a busy period manually).
WHATSAPP_AUTO_REPLY=true
#
# Webhook callback URL to register in Meta (subscribe to the `messages` field):
#   https://your-domain.com/webhook
# `/webhook` is rewritten to /api/whatsapp/webhook in next.config.mjs, so either
# path works — register whichever you prefer. Admin ▸ Integrations shows the
# exact URL derived from APP_URL.

# Google Maps (office location on the contact card)
GOOGLE_MAPS_API_KEY=

# --- Team routing -----------------------------------------------------------
# Where new records are announced. Falls back to SMTP_FROM when unset.
# Leads, quotes, consultations, support tickets and human handoffs. Each team
# (Sales, Enterprise, Support…) can have its own inboxes in Admin ▸ Chatbot
# Studio ▸ Teams; this is the inbox for any team without one.
SALES_NOTIFY_EMAIL=sales@bitsolmarketing.com

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for /api/cron/follow-ups, the smart follow-up scheduler. Call it
# every 15–30 minutes with `Authorization: Bearer <CRON_SECRET>`. Unset, the
# endpoint refuses to run. Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Seed accounts ----------------------------------------------------------
# Used once by `npm run db:seed`. Change the passwords before any real deploy.
SEED_ADMIN_EMAIL=admin@bitsol.local
SEED_ADMIN_PASSWORD=ChangeMe#2024
SEED_STAFF_PASSWORD=ChangeMe#2024

# --- Branding (surfaced in UI/footers) --------------------------------------
NEXT_PUBLIC_BRAND_NAME="BITSOL MARKETING"
NEXT_PUBLIC_BRAND_URL=https://bitsolmarketing.com
NEXT_PUBLIC_BRAND_TAGLINE="Empowering Businesses with Artificial Intelligence"
